# ==============================================================================
# BROKEN HORIZON — PLAYTEST & API ENVIRONMENT CONFIGURATION
# Copy to .env.local for local overrides. Never commit secrets to git.
# ==============================================================================

# Public Portal Base URL (Used for generating player access links in emails)
VITE_PLAYTEST_PORTAL_URL=https://broken-horizon.web.app

# Admin Clearance Master Secret Passphrase (Used for /admin/playtest authentication gate)
VITE_ADMIN_AUTH_SECRET=HORIZON-CLEARANCE-2026

# Google Sheets & Google Apps Script Webhook (100% Free - Logs signups & sends HTML emails)
# Get from: Google Sheet -> Extensions -> Apps Script -> Deploy as Web App
VITE_GOOGLE_APPS_SCRIPT_URL=

# Email Dispatch Webhook or API Provider (Resend / SendGrid / Custom SMTP Gateway)
# Leave empty to use built-in simulated development logging mode
VITE_EMAIL_WEBHOOK_URL=
VITE_EMAIL_API_KEY=
VITE_EMAIL_FROM_ADDRESS=playtest@brokenhorizon.studio

# Target Playtest Build Parameters
VITE_PLAYTEST_BUILD_NAME=Milestone 1 (Pre-Alpha)
VITE_PLAYTEST_PLATFORM=Windows PC (x64)
